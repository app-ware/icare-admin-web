# Fictional demo is available in development; production requires explicit opt-in.
ICARE_PREVIEW_ENABLED=false
# Existing dealer sign-in and scoped center reads. Configure secure SQL before enabling.
ICARE_LIVE_DATA_ENABLED=false
# Profile writes require an additional explicit switch; draft saving does not write legacy SQL.
ICARE_CENTER_WRITES_ENABLED=false
# Administrator-only dealer creation, profile/status/role changes and center assignments.
ICARE_DEALER_WRITES_ENABLED=false
# Existing center-user profile and secure sign-in status updates only.
# Does not enable creation, password changes or role assignment.
ICARE_CENTER_USER_WRITES_ENABLED=false
# Center activation writes are independent of profile/dealer/user changes.
ICARE_STATUS_WRITES_ENABLED=false
# Alert publishing/reset is independent of other feature switches.
ICARE_ALERT_WRITES_ENABLED=false
# Bus overrides/default restoration require reviewed references and separate acceptance.
ICARE_TRANSPORT_WRITES_ENABLED=false
# Private portal logo/photo changes only. Does not publish to legacy client photo folders.
ICARE_BRANDING_WRITES_ENABLED=false
# Required in production; exact external origin, without a trailing slash.
ICARE_APP_ORIGIN=
# Persistent server-local SQLite file for opaque sessions, rate limits, drafts and isolated demo data.
# Use a private persistent volume. Multi-host deployments need a shared replacement store.
ICARE_STORAGE_PATH=.local/portal.sqlite
# Server-only JSON config per SQL role. Populate privately; never use NEXT_PUBLIC_ for secrets.
# Example shape: {"server":"staging.example","database":"icare_secure","user":"portal_app","password":"...","options":{"encrypt":true,"trustServerCertificate":false}}
# The secure connection serves cross-database center queries on the same server. Use least privilege.
# Production rejects sysadmin, db_owner and CONTROL logins. The app never loads old project files.
ICARE_SQL_SECURE=
ICARE_SQL_NURSERY=
ICARE_SQL_SCHOOL=
ICARE_SQL_ACCOUNTING=
ICARE_SQL_LOGGING=
# Accounting/Logging pools remain unavailable regardless of these placeholders until their audit is complete.
# Optional local development compatibility for the owner-confirmed dev SQL server.
# Requires NODE_ENV=development, loopback ICARE_APP_ORIGIN and exact server match.
# Still encrypts SQL traffic, but permits that server's certificate and existing login.
# These exceptions cannot enable production access.
ICARE_DEV_SQL_COMPATIBILITY=false
ICARE_DEV_SQL_SERVER=
# Private JSON files are accepted only in the above local development mode.
ICARE_SQL_SECURE_FILE=
ICARE_SQL_NURSERY_FILE=
ICARE_SQL_SCHOOL_FILE=
